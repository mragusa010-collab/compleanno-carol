<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Perché Sei Speciale 🌸💖</title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Plus Jakarta Sans', sans-serif; }
    body { background: linear-gradient(135deg, #fff5f5 0%, #ffe3e8 50%, #f7d6e0 100%); min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 20px; color: #5c3d46; text-align: center; }
    .progress-bar { position: fixed; top: 0; left: 0; width: 60%; height: 6px; background: linear-gradient(90deg, #ff8fa3, #ff4d6d); }
    .container { max-width: 420px; width: 100%; }
    h2 { font-size: 1.8rem; color: #4a2833; margin-bottom: 5px; }
    .subtitle { font-size: 0.9rem; color: #8c5a68; margin-bottom: 25px; }
    .reasons { display: flex; flex-direction: column; gap: 14px; margin-bottom: 30px; }
    .reason-box { background: rgba(255, 255, 255, 0.9); border-radius: 20px; padding: 18px 20px; text-align: left; cursor: pointer; border: 1px solid white; box-shadow: 0 8px 20px rgba(220, 100, 130, 0.08); }
    .reason-head { display: flex; justify-content: space-between; align-items: center; font-weight: 700; color: #4a2833; font-size: 1rem; }
    .reason-body { display: none; margin-top: 10px; font-weight: 400; font-size: 0.92rem; color: #6c4b55; line-height: 1.5; border-top: 1px solid #ffe3e8; padding-top: 10px; }
    .reason-box.open .reason-body { display: block; }
    .nav { display: flex; gap: 12px; justify-content: center; }
    .btn { padding: 14px 24px; border-radius: 25px; text-decoration: none; font-weight: 700; font-size: 0.95rem; }
    .btn-main { background: linear-gradient(135deg, #ff8fa3, #ff4d6d); color: white; box-shadow: 0 8px 20px rgba(255, 77, 109, 0.3); }
    .btn-ghost { background: rgba(255, 255, 255, 0.8); color: #6c4b55; border: 1px solid white; }
  </style>
</head>
<body>
  <div class="progress-bar"></div>
  <div class="container">
    <h2>Cosa amo di te 🌸</h2>
    <p class="subtitle">Clicca sulle caselle per scoprire i motivi 💕</p>

    <div class="reasons">
      <% data.motivi.forEach(m => { %>
        <div class="reason-box" onclick="this.classList.toggle('open')">
          <div class="reason-head">
            <span><%= m.icona %> <%= m.titolo %></span>
            <span>✦</span>
          </div>
          <div class="reason-body"><%= m.testo %></div>
        </div>
      <% }); %>
    </div>

    <div class="nav">
      <a href="/ricordi" class="btn btn-ghost">⬅️ Indietro</a>
      <a href="/premessa" class="btn btn-main">Ho ancora un'altra cosa... 🎁</a>
    </div>
  </div>
</body>
</html>
