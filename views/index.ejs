<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Per Te 🧸💖</title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Plus Jakarta Sans', sans-serif; }
    body { 
      background: linear-gradient(135deg, #fff5f5 0%, #ffe3e8 50%, #f7d6e0 100%); 
      min-height: 100vh; 
      display: flex; 
      align-items: center; 
      justify-content: center; 
      padding: 20px; 
      color: #5c3d46; 
      text-align: center; 
      overflow-x: hidden;
    }
    
    /* FRAME PER LE PAGINE */
    .app-frame {
      width: 100%;
      max-width: 440px;
      height: 90vh;
      max-height: 700px;
      border: none;
      border-radius: 32px;
      background: transparent;
      z-index: 10;
    }

    /* WIDGET MUSICA IN BASSO A DESTRA */
    .music-widget {
      position: fixed;
      bottom: 20px;
      right: 20px;
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.8);
      border-radius: 30px;
      padding: 8px 14px 8px 10px;
      display: none; /* Si attiva dopo il PIN */
      align-items: center;
      gap: 10px;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);
      z-index: 1000;
      cursor: pointer;
      user-select: none;
      transition: transform 0.2s ease;
    }

    .music-widget:active { transform: scale(0.95); }

    .music-info {
      display: flex;
      flex-direction: column;
      text-align: right;
    }

    .music-title { font-size: 0.8rem; font-weight: 700; color: #4a2833; line-height: 1.1; }
    .music-artist { font-size: 0.7rem; color: #ff4d6d; font-weight: 600; }

    /* DISCO CHE GIRA */
    .vinyl-disk {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      background: #111;
      border: 2px solid #ffffff;
      box-shadow: 0 2px 8px rgba(0,0,0,0.2);
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      animation: spin 3s linear infinite;
      animation-play-state: paused;
    }

    .vinyl-disk img { width: 100%; height: 100%; object-fit: cover; border-radius: 50%; }

    .vinyl-center {
      position: absolute;
      width: 10px;
      height: 10px;
      background: white;
      border-radius: 50%;
      border: 2px solid #ff4d6d;
    }

    @keyframes spin {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }
  </style>
</head>
<body>

  <audio id="bg-music" preload="auto" playsinline loop crossorigin="anonymous">
    <source src="https://files.catbox.moe/3e10m0.mp3" type="audio/mpeg">
  </audio>

  <iframe id="content-frame" class="app-frame" src="/home-content"></iframe>

  <div class="music-widget" id="music-widget" onclick="togglePlay()">
    <div class="music-info">
      <span class="music-title">Sparks ✨</span>
      <span class="music-artist">Coldplay</span>
    </div>
    <div class="vinyl-disk" id="vinyl-disk">
      <img src="https://i.scdn.co/image/ab67616d0000b273e0215034375b642646b14644" alt="Coldplay - Parachutes">
      <div class="vinyl-center"></div>
    </div>
  </div>

  <script>
    const audio = document.getElementById('bg-music');
    const vinyl = document.getElementById('vinyl-disk');
    const widget = document.getElementById('music-widget');

    // Funzione chiamata dalla pagina interna quando il PIN è corretto
    function startMusic() {
      widget.style.display = "flex";
      audio.load();
      audio.play().then(() => {
        vinyl.style.animationPlayState = "running";
      }).catch(err => {
        console.log("Riproduzione manuale richiesta:", err);
      });
    }

    function togglePlay() {
      if (audio.paused) {
        audio.play().then(() => {
          vinyl.style.animationPlayState = "running";
        });
      } else {
        audio.pause();
        vinyl.style.animationPlayState = "paused";
      }
    }
  </script>
</body>
</html>
