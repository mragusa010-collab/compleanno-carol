<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Per Te 🧸💖</title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Plus Jakarta Sans', sans-serif; }
    body { background: linear-gradient(135deg, #fff5f5 0%, #ffe3e8 50%, #f7d6e0 100%); min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 20px; color: #5c3d46; text-align: center; }
    .progress-bar { position: fixed; top: 0; left: 0; width: 0%; height: 6px; background: linear-gradient(90deg, #ff8fa3, #ff4d6d); transition: width 0.4s ease; z-index: 100; }
    .glass-card { background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(16px); border: 2px solid #ffffff; border-radius: 32px; padding: 40px 25px; max-width: 420px; width: 100%; box-shadow: 0 20px 40px rgba(220, 100, 130, 0.15); }
    .badge { display: inline-block; background: #ffe3e8; color: #d81159; font-size: 0.85rem; font-weight: 700; padding: 8px 16px; border-radius: 20px; margin-bottom: 20px; }
    h1 { font-size: 1.8rem; color: #4a2833; margin-bottom: 15px; }
    p { font-size: 1rem; color: #6c4b55; line-height: 1.6; margin-bottom: 30px; }
    .btn { display: inline-block; background: linear-gradient(135deg, #ff8fa3, #ff4d6d); color: white; padding: 16px 32px; border-radius: 30px; text-decoration: none; font-weight: 700; font-size: 1rem; box-shadow: 0 10px 22px rgba(255, 77, 109, 0.35); border: none; cursor: pointer; }

    /* STILI SCHERMATA PIN */
    .pin-input {
      width: 100%;
      max-width: 220px;
      padding: 12px;
      font-size: 1.3rem;
      text-align: center;
      letter-spacing: 5px;
      border: 2px solid #ffb3c1;
      border-radius: 16px;
      outline: none;
      color: #ff4d6d;
      font-weight: 700;
      background: #fff;
      margin-bottom: 15px;
    }
    .pin-input:focus { border-color: #ff4d6d; }
    .error-msg { color: #d81159; font-size: 0.88rem; margin-bottom: 12px; display: none; font-weight: 600; }
    .hint-text { font-size: 0.85rem; color: #88626e; margin-top: 18px; font-style: italic; }
    
    #main-content { display: none; }

    /* WIDGET MUSICA IN BASSO A DESTRA */
    .music-widget {
      position: fixed;
      bottom: 20px;
      right: 20px;
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.8);
      border-radius: 30px;
      padding: 8px 14px 8px 10px;
      display: none;
      align-items: center;
      gap: 10px;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);
      z-index: 1000;
      cursor: pointer;
      user-select: none;
      transition: transform 0.2s ease;
    }

    .music-widget:active { transform: scale(0.95); }

    .music-info {
      display: flex;
      flex-direction: column;
      text-align: right;
    }

    .music-title { font-size: 0.8rem; font-weight: 700; color: #4a2833; line-height: 1.1; }
    .music-artist { font-size: 0.7rem; color: #ff4d6d; font-weight: 600; }

    /* DISCO CHE GIRA */
    .vinyl-disk {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      background: #111;
      border: 2px solid #ffffff;
      box-shadow: 0 2px 8px rgba(0,0,0,0.2);
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      animation: spin 3s linear infinite;
      animation-play-state: paused;
    }

    .vinyl-disk img { width: 100%; height: 100%; object-fit: cover; border-radius: 50%; }

    .vinyl-center {
      position: absolute;
      width: 10px;
      height: 10px;
      background: white;
      border-radius: 50%;
      border: 2px solid #ff4d6d;
    }

    @keyframes spin {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }
  </style>
</head>
<body>
  <div id="hearts-container"></div>
  <div class="progress-bar" id="progress-bar"></div>

 <audio id="bg-music" preload="auto" playsinline loop>
  <source src="https://files.catbox.moe/iqveyh.mp3" type="audio/mpeg">
</audio>

  <main class="glass-card" id="site-pin-box">
    <div class="badge">🔒 Area Riservata</div>
    <h1>Un Posto Segreto 🔑</h1>
    <p>Inserisci il PIN speciale a 6 cifre per sbloccare il tuo regalo...</p>
    
    <div>
      <input type="password" id="site-pin-input" class="pin-input" maxlength="6" placeholder="******" pattern="\d*">
    </div>
    
    <p class="error-msg" id="site-error-msg">PIN errato! Riprova ❤️</p>
    <button class="btn" id="btn-unlock" onclick="checkSitePin()">Entra 💖</button>
    
    <p class="hint-text">💡 Suggerimento: La data del nostro primo bacio (GGMMAA)</p>
  </main>

  <main class="glass-card" id="main-content">
    <div class="badge">✦ Tanti Auguri Cucciola ✦</div>
    <h1>Questo è il mio regalo di compleanno per te... 🎀</h1>
    <p>Quello che hai visto prima all'interno del pacco era solo un piccolo pensiero che ti ho fatto, ma il vero regalo inizia ora. Quello che vedi qui sono tanto tempo di prove e ancora prove per farlo funzionare ma sopratutto una specie di album con tutti i nostri ricordi e i nostri momenti migliori. Sei pronta a fare questo piccolo viaggio insieme?</p>
    <a href="/ricordi" class="btn">Inizia il viaggio ✨</a>
  </main>

  <div class="music-widget" id="music-widget">
    <div class="music-info">
      <span class="music-title">Sparks ✨</span>
      <span class="music-artist">Coldplay</span>
    </div>
    <div class="vinyl-disk" id="vinyl-disk">
      <img src="/img/disco.jpg" alt="Copertina">
      <div class="vinyl-center"></div>
    </div>
  </div>

  <script src="/js/script.js"></script>
  <script>
    const audio = document.getElementById('bg-music');

    // Pre-carica l'audio non appena l'utente tocca il campo del PIN o lo schermo
    document.body.addEventListener('touchstart', unlockAudioContext, { once: true });
    document.body.addEventListener('click', unlockAudioContext, { once: true });

    function unlockAudioContext() {
      if (audio) {
        audio.load();
      }
    }

    function checkSitePin() {
      const pinCorrect = "280726";
      const userPin = document.getElementById('site-pin-input').value;
      const errorMsg = document.getElementById('site-error-msg');
      const pinBox = document.getElementById('site-pin-box');
      const mainContent = document.getElementById('main-content');
      const progressBar = document.getElementById('progress-bar');

      if (userPin === pinCorrect) {
        errorMsg.style.display = "none";
        pinBox.style.display = "none";
        mainContent.style.display = "block";
        progressBar.style.width = "20%";

        // Sblocca e avvia la musica: da qui in poi resta sincronizzata su tutte le pagine
        localStorage.setItem('musicUnlocked', 'true');

        const vinyl = document.getElementById('vinyl-disk');
        const widget = document.getElementById('music-widget');
        widget.style.display = "flex";

        audio.currentTime = 0;
        const playPromise = audio.play();

        if (playPromise !== undefined) {
          playPromise.then(() => {
            vinyl.style.animationPlayState = "running";
            saveMusicState(audio);
          }).catch(error => {
            console.warn("Riproduzione automatica bloccata:", error);
            vinyl.style.animationPlayState = "paused";
          });
        }
      } else {
        errorMsg.style.display = "block";
        document.getElementById('site-pin-input').value = "";
      }
    }

    document.getElementById('site-pin-input').addEventListener('keypress', function (e) {
      if (e.key === 'Enter') {
        checkSitePin();
      }
    });
  </script>
</body>
</html>
