<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Una Premessa Speciale 💌</title>
  
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700&family=Sacramento&display=swap" rel="stylesheet">
  
  <link rel="stylesheet" href="/css/style.css">

  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Plus Jakarta Sans', sans-serif; }
    body { background: linear-gradient(135deg, #fff5f5 0%, #ffe3e8 50%, #f7d6e0 100%); min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 30px 15px; color: #5c3d46; text-align: center; overflow-x: hidden; }
    
    .progress-bar { position: fixed; top: 0; left: 0; width: 80%; height: 6px; background: linear-gradient(90deg, #ff8fa3, #ff4d6d); z-index: 100; }
    
    .container { width: 100%; max-width: 420px; animation: fadeIn 0.8s ease; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    
    h2 { font-family: 'Sacramento', cursive; font-size: 2.8rem; color: #ff4d6d; margin-bottom: 10px; }
    .intro-text { font-size: 0.95rem; color: #6c4b55; line-height: 1.5; margin-bottom: 25px; }

    /* BOX PIN DI SBLOCCO */
    .pin-card {
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(10px);
      border-radius: 20px;
      padding: 25px 20px;
      box-shadow: 0 10px 25px rgba(220, 100, 130, 0.15);
      border: 2px solid white;
      margin-bottom: 35px;
      transition: all 0.5s ease;
    }

    .pin-card .lock-icon { font-size: 3rem; margin-bottom: 10px; }
    .pin-card h3 { font-family: 'Sacramento', cursive; font-size: 2.2rem; color: #ff4d6d; margin-bottom: 5px; }
    .pin-card p { font-size: 0.9rem; color: #6c4b55; margin-bottom: 15px; }

    .pin-input-group {
      display: flex;
      justify-content: center;
      gap: 8px;
      margin-bottom: 12px;
    }

    .pin-input {
      width: 100%;
      max-width: 200px;
      padding: 12px;
      font-size: 1.2rem;
      text-align: center;
      letter-spacing: 4px;
      border: 2px solid #ffb3c1;
      border-radius: 12px;
      outline: none;
      color: #ff4d6d;
      font-weight: 700;
      background: #fff;
    }

    .pin-input:focus { border-color: #ff4d6d; }

    .btn-unlock {
      background: linear-gradient(135deg, #ff8fa3, #ff4d6d);
      color: white;
      border: none;
      padding: 10px 22px;
      border-radius: 20px;
      font-weight: 700;
      font-size: 0.9rem;
      cursor: pointer;
      box-shadow: 0 4px 12px rgba(255, 77, 109, 0.3);
    }

    .hint-text {
      font-size: 0.82rem;
      color: #88626e;
      margin-top: 15px;
      font-style: italic;
    }

    .error-msg {
      color: #d81159;
      font-size: 0.85rem;
      margin-top: 8px;
      display: none;
      font-weight: 600;
    }

    /* EFFETTO LETTERA / CARD FLIP */
    .letter-container {
      perspective: 1000px;
      margin-bottom: 35px;
      display: none; /* Inizialmente nascosta finché non inserisce il PIN */
    }
    
    .flip-card {
      width: 100%;
      min-height: 460px;
      position: relative;
      transform-style: preserve-3d;
      transition: transform 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .flip-card.flipped {
      transform: rotateY(180deg);
    }

    .card-front, .card-back {
      position: absolute;
      width: 100%;
      height: 100%;
      backface-visibility: hidden;
      -webkit-backface-visibility: hidden;
      border-radius: 20px;
      padding: 25px 20px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      box-shadow: 0 10px 25px rgba(220, 100, 120, 0.15);
      border: 2px solid white;
    }

    .card-front {
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(10px);
    }

    .card-front .envelope-icon { font-size: 4rem; margin-bottom: 15px; animation: pulse 2s infinite; }
    .card-front h3 { font-family: 'Sacramento', cursive; font-size: 2.2rem; color: #ff4d6d; margin-bottom: 8px; }
    .card-front p { font-size: 0.88rem; color: #88626e; }

    .card-back {
      background: #ffffff;
      transform: rotateY(180deg);
      text-align: left;
      overflow-y: auto;
      justify-content: flex-start;
    }

    .card-back h3 {
      font-family: 'Sacramento', cursive;
      font-size: 2.3rem;
      color: #ff4d6d;
      text-align: center;
      width: 100%;
      margin-bottom: 12px;
      border-bottom: 2px dashed #ffe3e8;
      padding-bottom: 5px;
    }

    .card-back p {
      font-size: 0.90rem;
      line-height: 1.6;
      color: #5c3d46;
      white-space: pre-line;
      margin-bottom: 12px;
    }

    /* GALLERY POLAROID */
    .photo-stack { display: flex; flex-direction: column; gap: 20px; margin-bottom: 30px; }
    .polaroid-frame {
      background: white; 
      padding: 12px 12px 20px 12px; 
      border-radius: 12px;
      box-shadow: 0 8px 20px rgba(200, 100, 120, 0.15); 
      transform: rotate(-1.5deg);
      width: 100%;
      margin: 0 auto;
    }
    .polaroid-frame:nth-child(even) { transform: rotate(1.5deg); }
    .polaroid-frame img { 
      width: 100%; 
      height: 250px; 
      object-fit: cover; 
      border-radius: 6px; 
      margin-bottom: 10px; 
      display: block;
    }
    .caption { font-family: 'Sacramento', cursive; font-size: 1.6rem; color: #ff4d6d; }

    .nav { display: flex; gap: 10px; justify-content: center; margin-top: 15px; }
    .btn { padding: 12px 20px; border-radius: 25px; text-decoration: none; font-weight: 700; font-size: 0.9rem; }
    .btn-main { background: linear-gradient(135deg, #ff8fa3, #ff4d6d); color: white; box-shadow: 0 8px 20px rgba(255, 77, 109, 0.3); }
    .btn-ghost { background: rgba(255, 255, 255, 0.8); color: #6c4b55; border: 1px solid white; }

    @keyframes pulse {
      0% { transform: scale(1); }
      50% { transform: scale(1.1); }
      100% { transform: scale(1); }
    }
  </style>
</head>
<body>

  <div id="hearts-container"></div>

  <div class="progress-bar"></div>

  <main class="container">
    <h2>Le Nostre Foto 📸</h2>
    <p class="intro-text">Per leggere la lettera segreta inserisci il PIN di sblocco... ❤️</p>

    <div class="pin-card" id="pin-box">
      <div class="lock-icon">🔒</div>
      <h3>Lettera Protetto</h3>
      <p>Inserisci il PIN a 6 cifre per sbloccare:</p>
      
      <div class="pin-input-group">
        <input type="password" id="pin-input" class="pin-input" maxlength="6" placeholder="******" pattern="\d*">
      </div>
      
      <button class="btn-unlock" onclick="checkPin()">Sblocca 🔑</button>
      
      <p class="error-msg" id="error-msg">PIN errato! Riprova 😉</p>
      <p class="hint-text">💡 Suggerimento: La data in cui ci siamo conosciuti (GGMMAA)</p>
    </div>

    <div class="letter-container" id="letter-box" onclick="flipCard(this.querySelector('.flip-card'))">
      <div class="flip-card" id="flip-card-element">
        
        <div class="card-front">
          <div class="envelope-icon">💌</div>
          <h3>Una lettera per te</h3>
          <p>👇 Clicca per aprire e leggere</p>
        </div>

        <div class="card-back">
          <h3>PREMESSA</h3>
          <p>Ci siamo conosciuti esattamente il 4 Luglio 2025 e quella notte, alle 04:36, ti ho scritto il mio primissimo messaggio. Ricordo ancora l'agitazione prima di inviarlo: ho pensato a qualsiasi scusa, anche la più futile e assurda, pur di trovare un pretesto per iniziare a parlarti. Alla fine ti ho chiesto se avevi il mio accendino, pur sapendo benissimo che era riposto al sicuro nella mia pochette... ma la verità è che dovevo assolutamente trovare un modo per entrare nella tua vita.</p>
          <p>Da quella notte non c'è stato un solo giorno in cui non ci siamo scritti. Messaggio dopo messaggio, nottata dopo nottata, abbiamo iniziato a conoscerci davvero, abbattendo ogni difesa fino ad arrivare alle sfumature più intime e vere del nostro carattere. Già da quella prima chat avevo chiarissimo nel cuore che non saresti stata una persona qualunque per me: sapevo che avresti stravolto le mie giornate e che avremmo condiviso un mare di ricordi, risate e momenti preziosi.</p>
          <p>Rivedere tutto il percorso fatto insieme mi fa capire quanto ogni singolo istante sia stato unico. Detto questo, ci tenevo a scriverti queste parole per ricordarti una cosa semplice ma immensa: per me sei fundamental, hai un posto speciale che nessun altro potrà mai occupare e lo rimarrai sempre, comunque vada a finire. ❤️</p>
        </div>

      </div>
    </div>

    <div class="photo-stack">
      <% if (data.fotoPremessa && data.fotoPremessa.length > 0) { %>
        <% data.fotoPremessa.forEach(f => { %>
          <div class="polaroid-frame">
            <img src="<%= f.url %>" alt="<%= f.didascalia %>">
            <div class="caption"><%= f.didascalia %></div>
          </div>
        <% }); %>
      <% } %>
    </div>

    <div class="nav">
      <a href="/motivi" class="btn btn-ghost">⬅️ Indietro</a>
      <a href="/domanda" class="btn btn-main">Ho una domanda molto speciale per te ✨</a>
    </div>
  </main>

  <script src="/js/script.js"></script>
  <script>
    function checkPin() {
      const pinCorrect = "040726";
      const userPin = document.getElementById('pin-input').value;
      const errorMsg = document.getElementById('error-msg');
      const pinBox = document.getElementById('pin-box');
      const letterBox = document.getElementById('letter-box');
      const flipCardElem = document.getElementById('flip-card-element');

      if (userPin === pinCorrect) {
        errorMsg.style.display = "none";
        pinBox.style.display = "none";
        letterBox.style.display = "block";
        
        // Gira automaticamente la lettera una volta sbloccata
        setTimeout(() => {
          flipCardElem.classList.add('flipped');
        }, 300);
      } else {
        errorMsg.style.display = "block";
        document.getElementById('pin-input').value = "";
      }
    }

    // Permette di premere Invio sulla tastiera per confermare il PIN
    document.getElementById('pin-input').addEventListener('keypress', function (e) {
      if (e.key === 'Enter') {
        checkPin();
      }
    });
  </script>
</body>
</html>
