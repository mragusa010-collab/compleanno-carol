<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Le Nostre Foto 🖼️💖</title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700&family=Sacramento&display=swap" rel="stylesheet">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Plus Jakarta Sans', sans-serif; }
    body { background: linear-gradient(135deg, #fff5f5 0%, #ffe3e8 50%, #f7d6e0 100%); min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 30px 15px; color: #5c3d46; text-align: center; overflow-x: hidden; }
    .progress-bar { position: fixed; top: 0; left: 0; width: 80%; height: 6px; background: linear-gradient(90deg, #ff8fa3, #ff4d6d); }
    
    .container { width: 100%; max-width: 400px; animation: fadeIn 0.8s ease; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    
    h2 { font-family: 'Sacramento', cursive; font-size: 2.8rem; color: #ff4d6d; margin-bottom: 10px; }
    .intro-text { font-size: 0.95rem; color: #6c4b55; line-height: 1.5; margin-bottom: 25px; }

    /* GALLERY POLAROID PER CELLULARE */
    .photo-stack { display: flex; flex-direction: column; gap: 20px; margin-bottom: 30px; }
    .polaroid-frame {
      background: white; 
      padding: 12px 12px 20px 12px; 
      border-radius: 12px;
      box-shadow: 0 8px 20px rgba(200, 100, 120, 0.15); 
      transform: rotate(-1.5deg);
      width: 100%;
      margin: 0 auto;
    }
    .polaroid-frame:nth-child(even) { transform: rotate(1.5deg); }
    .polaroid-frame img { 
      width: 100%; 
      height: 250px; 
      object-fit: cover; 
      border-radius: 6px; 
      margin-bottom: 10px; 
      display: block;
    }
    .caption { font-family: 'Sacramento', cursive; font-size: 1.6rem; color: #ff4d6d; }

    .nav { display: flex; gap: 10px; justify-content: center; margin-top: 15px; }
    .btn { padding: 12px 20px; border-radius: 25px; text-decoration: none; font-weight: 700; font-size: 0.9rem; }
    .btn-main { background: linear-gradient(135deg, #ff8fa3, #ff4d6d); color: white; box-shadow: 0 8px 20px rgba(255, 77, 109, 0.3); }
    .btn-ghost { background: rgba(255, 255, 255, 0.8); color: #6c4b55; border: 1px solid white; }
  </style>
</head>
<body>
  <div class="progress-bar"></div>
  <div class="container">
    <h2>Le Nostre Foto 📸</h2>
    <p class="intro-text">Alcuni scatti speciali dedicati a noi... ❤️</p>

    <div class="photo-stack">
      <% data.fotoPremessa.forEach(f => { %>
        <div class="polaroid-frame">
          <img src="<%= f.url %>" alt="<%= f.didascalia %>">
          <div class="caption"><%= f.didascalia %></div>
        </div>
      <% }); %>
    </div>

    <div class="nav">
      <a href="/motivi" class="btn btn-ghost">⬅️ Indietro</a>
      <a href="/domanda" class="btn btn-main">Continua ✨</a>
    </div>
  </div>
</body>
</html>